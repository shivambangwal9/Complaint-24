# Complain 24 — Environment Variables Template
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to Git.

# --- JWT ---
JWT_SECRET=your_super_secret_jwt_key_here

# --- DATABASE ---
# Leave as default for SQLite (local/Render ephemeral)
# Set to /data/complain24.db if using Render Persistent Disk
DB_PATH=complain24.db

# --- OTP EMAIL (Optional - Gmail SMTP) ---
# Generate an App Password at: https://myaccount.google.com/apppasswords
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

# --- GETOTP SMS (Optional - https://otp.dev) ---
GETOTP_API_KEY=your_getotp_api_key
GETOTP_TEMPLATE_ID=your_template_id
GETOTP_SENDER=your_sender_id
